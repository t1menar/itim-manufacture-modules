{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manufacture.local/contracts/topic.json",
  "title": "Topic catalog entry (module-video, D21)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "title", "active", "rev"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": ["string", "null"], "maxLength": 4000 },
    "default_tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" }
    },
    "default_platforms": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }
    },
    "active": { "type": "boolean" },
    "rev": { "type": "integer", "minimum": 1 }
  }
}
