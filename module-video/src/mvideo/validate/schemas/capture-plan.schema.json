{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://manufacture.local/schemas/video/capture-plan-1.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "image",
  "sessions",
  "ops"
 ],
 "properties": {
  "format": {
   "const": "manufacture.capture-plan/1"
  },
  "image": {
   "type": "string"
  },
  "sessions": {
   "type": "object",
   "minProperties": 1,
   "maxProperties": 4,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]{0,23}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind"
    ],
    "properties": {
     "kind": {
      "enum": [
       "psql",
       "sh"
      ]
     },
     "database": {
      "type": "string"
     },
     "workdir": {
      "type": "string"
     },
     "open_at_start": {
      "type": "boolean"
     }
    }
   }
  },
  "ops": {
   "type": "array",
   "minItems": 1,
   "maxItems": 120,
   "items": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "op",
       "session"
      ],
      "properties": {
       "op": {
        "enum": [
         "open",
         "close"
        ]
       },
       "session": {
        "type": "string"
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "op",
       "session",
       "text"
      ],
      "properties": {
       "op": {
        "const": "setup"
       },
       "session": {
        "type": "string"
       },
       "text": {
        "type": "string",
        "maxLength": 2000
       },
       "expect_error": {
        "type": "boolean"
       },
       "why": {
        "type": "string",
        "maxLength": 200
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "op",
       "cmd"
      ],
      "properties": {
       "op": {
        "const": "run"
       },
       "cmd": {
        "type": "string"
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "op",
       "name",
       "session",
       "query",
       "why_equal"
      ],
      "properties": {
       "op": {
        "const": "value"
       },
       "name": {
        "type": "string"
       },
       "session": {
        "type": "string"
       },
       "query": {
        "type": "string",
        "maxLength": 2000
       },
       "parse": {
        "enum": [
         "single",
         "first_line",
         "count_lines"
        ]
       },
       "why_equal": {
        "type": "string",
        "maxLength": 300
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "op",
       "seconds"
      ],
      "properties": {
       "op": {
        "const": "sleep"
       },
       "seconds": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 5
       }
      }
     }
    ]
   }
  }
 }
}
