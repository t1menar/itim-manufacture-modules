{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://manufacture.local/schemas/video/research-1.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "commit",
  "viewer_questions",
  "misconceptions",
  "call_path",
  "facts",
  "terms",
  "capture_needs"
 ],
 "properties": {
  "format": {
   "const": "manufacture.research/1"
  },
  "commit": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "viewer_questions": {
   "type": "array",
   "minItems": 3,
   "maxItems": 12,
   "items": {
    "type": "object",
    "required": [
     "question",
     "source"
    ],
    "properties": {
     "question": {
      "type": "string"
     },
     "source": {
      "type": "string",
      "format": "uri"
     }
    }
   }
  },
  "misconceptions": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "claim",
     "truth",
     "facts"
    ],
    "properties": {
     "claim": {
      "type": "string"
     },
     "truth": {
      "type": "string"
     },
     "facts": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^f[0-9]+$"
      }
     }
    }
   }
  },
  "call_path": {
   "type": "array",
   "minItems": 1,
   "maxItems": 20,
   "items": {
    "type": "object",
    "required": [
     "function",
     "file",
     "line_start",
     "line_end",
     "role"
    ],
    "properties": {
     "function": {
      "type": "string"
     },
     "file": {
      "type": "string"
     },
     "line_start": {
      "type": "integer"
     },
     "line_end": {
      "type": "integer"
     },
     "role": {
      "type": "string",
      "maxLength": 200
     },
     "key_lines": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "n",
        "expect",
        "why"
       ],
       "properties": {
        "n": {
         "type": "integer"
        },
        "expect": {
         "type": "string"
        },
        "why": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "facts": {
   "type": "array",
   "minItems": 3,
   "maxItems": 60,
   "items": {
    "type": "object",
    "required": [
     "id",
     "text",
     "cite"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^f[0-9]{1,3}$"
     },
     "text": {
      "type": "string",
      "maxLength": 300
     },
     "cite": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "file",
         "line",
         "quote"
        ],
        "properties": {
         "file": {
          "type": "string"
         },
         "line": {
          "type": "integer"
         },
         "quote": {
          "type": "string",
          "minLength": 4
         }
        }
       },
       {
        "type": "object",
        "required": [
         "url",
         "quote"
        ],
        "properties": {
         "url": {
          "type": "string",
          "format": "uri"
         },
         "quote": {
          "type": "string",
          "maxLength": 300
         }
        }
       }
      ]
     }
    }
   }
  },
  "terms": {
   "type": "array",
   "maxItems": 30,
   "items": {
    "type": "object",
    "required": [
     "term",
     "explain",
     "must_explain"
    ],
    "properties": {
     "term": {
      "type": "string"
     },
     "explain": {
      "type": "string",
      "maxLength": 140
     },
     "must_explain": {
      "type": "boolean"
     },
     "aliases": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "capture_needs": {
   "type": "array",
   "maxItems": 30,
   "items": {
    "type": "object",
    "required": [
     "name",
     "meaning",
     "how"
    ],
    "properties": {
     "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
     },
     "meaning": {
      "type": "string"
     },
     "how": {
      "type": "string"
     }
    }
   }
  }
 }
}
