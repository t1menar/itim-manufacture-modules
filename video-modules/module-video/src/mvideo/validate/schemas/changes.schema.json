{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://manufacture.local/schemas/video/changes-1.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "reason_quote",
  "summary",
  "items"
 ],
 "properties": {
  "format": {
   "const": "manufacture.changes/1"
  },
  "reason_quote": {
   "type": "string"
  },
  "summary": {
   "type": "string",
   "maxLength": 400
  },
  "items": {
   "type": "array",
   "minItems": 1,
   "maxItems": 30,
   "items": {
    "type": "object",
    "required": [
     "path",
     "before",
     "after",
     "why"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "before": {},
     "after": {},
     "why": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "scope_note": {
   "type": "string",
   "maxLength": 300
  }
 }
}
