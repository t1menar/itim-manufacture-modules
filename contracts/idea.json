{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manufacture.local/contracts/idea.json",
  "title": "Idea snapshot (module-video → core, D21)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rev",
    "idea_ref",
    "title",
    "description",
    "language",
    "priority",
    "topic"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "rev": { "type": "integer", "minimum": 1 },
    "idea_ref": {
      "type": "string",
      "pattern": "^idea:[0-9]+:v[0-9]+$",
      "description": "Stable business key idea:<id>:v<rev>"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "hook": { "type": ["string", "null"], "maxLength": 300 },
    "audience": { "type": ["string", "null"], "maxLength": 500 },
    "language": { "const": "en" },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" }
    },
    "references": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "note": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    },
    "constraints": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "duration_s": { "type": "integer", "minimum": 15, "maximum": 900 },
        "format": { "type": "string", "enum": ["reel", "short", "other"] },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    },
    "priority": { "type": "integer", "minimum": -100, "maximum": 100 },
    "pipeline_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "notes": { "type": ["string", "null"], "maxLength": 2000 },
    "author": {
      "type": ["string", "null"],
      "pattern": "^(tg|db|user):.+$"
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "title", "rev"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "default_tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" }
        },
        "default_platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rev": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
