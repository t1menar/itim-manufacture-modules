{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publish-input.schema.json",
  "type": "object",
  "required": [
    "idea",
    "intents"
  ],
  "properties": {
    "idea": {
      "type": "object"
    },
    "channels": {
      "type": "array"
    },
    "upstream": {
      "type": "object"
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "intent_id",
          "content_revision_id",
          "generation"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "format": "uuid"
          },
          "content_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
