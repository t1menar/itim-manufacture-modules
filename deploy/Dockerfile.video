# Deploy-only video image. Does not modify module-video/ sources.
# Adds prompts/ at the path PROMPTS_ROOT resolves to under a non-editable install:
#   site-packages/mvideo/agents/prompts.py → parents[3] / "prompts"
#   = /app/.venv/lib/python3.12/prompts
ARG PYTHON_IMAGE=python:3.12-slim

FROM ${PYTHON_IMAGE} AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY module-video/pyproject.toml module-video/uv.lock module-video/README.md ./
COPY module-video/src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM ${PYTHON_IMAGE}
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin mvideo
COPY --from=build /app/.venv /app/.venv
COPY module-video/fonts/ /usr/share/fonts/manufacture/
# Seed prompts for DB seed_from_files at startup (see mvideo.agents.prompts.PROMPTS_ROOT).
COPY module-video/prompts/ /app/.venv/lib/python3.12/prompts/
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
USER 10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD ["python", "-c", "import os, urllib.request as u; u.urlopen('http://127.0.0.1:' + os.environ['VIDEO_LISTEN_ADDR'].rsplit(':', 1)[1] + '/health', timeout=2)"]
ENTRYPOINT ["mvideo"]
