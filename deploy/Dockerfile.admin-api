# Build from repository root:
#   docker build -f deploy/Dockerfile.admin-api -t manufacture-admin-api:local .
ARG GO_IMAGE=golang:1.26-bookworm
ARG NODE_IMAGE=node:22-bookworm
FROM ${NODE_IMAGE} AS ui
WORKDIR /ui
COPY admin-panel/package.json admin-panel/package-lock.json ./
RUN npm ci
COPY admin-panel/ ./
RUN npm run build

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY admin-api/go.mod admin-api/go.sum ./
RUN go mod download
COPY admin-api/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/admin-api ./cmd/admin-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/admin-api /admin-api
COPY --from=ui /ui/dist /ui
ENV ADMIN_UI_DIR=/ui
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/admin-api"]
CMD ["serve"]
