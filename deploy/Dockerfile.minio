# Local MinIO (official Hub/Quay images often unauthorized).
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
  && curl -fsSL -o /usr/local/bin/minio \
    "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-amd64.RELEASE.2025-09-07T16-13-09Z" \
  && curl -fsSL -o /usr/local/bin/mc \
    "https://github.com/minio/mc/releases/download/RELEASE.2025-08-13T08-35-41Z/mc.linux-amd64.RELEASE.2025-08-13T08-35-41Z" \
  && chmod +x /usr/local/bin/minio /usr/local/bin/mc \
  && rm -rf /var/lib/apt/lists/*
COPY entrypoint-minio.sh /entrypoint-minio.sh
RUN chmod +x /entrypoint-minio.sh
ENV MINIO_ROOT_USER=manufacture MINIO_ROOT_PASSWORD=manufacture_dev_secret S3_BUCKET=manufacture
EXPOSE 9000 9001
VOLUME ["/data"]
HEALTHCHECK --interval=3s --timeout=5s --retries=20 CMD curl -f http://127.0.0.1:9000/minio/health/live || exit 1
ENTRYPOINT ["/entrypoint-minio.sh"]
