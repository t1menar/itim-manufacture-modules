# Copy to deploy/.env (git-ignored) and fill in. Never commit real values.

# --- Manufacture core -------------------------------------------------------------------------
MF_ADMIN_TOKEN=            # >= 32 chars; the admin token for mfctl and the panel
RABBITMQ_USER=guest        # broker user shared by the core and the modules (local stack)
RABBITMQ_PASSWORD=guest

# --- MinIO (existing, https) ------------------------------------------------------------------
S3_ENDPOINT=               # internal API host[:port] the containers reach, e.g. minio.example.com
S3_SECURE=true             # https to S3_ENDPOINT
S3_PUBLIC_ENDPOINT=        # host Meta/Telegram download from (signed presigned URLs), e.g. minio.example.com
S3_PUBLIC_SECURE=true
S3_ACCESS_KEY=             # key with read/write on the two buckets below
S3_SECRET_KEY=
S3_BUCKET=manufacture      # artifacts of the modules (video, cover)
MF_S3_BUCKET=mf-blobs      # claim-check blobs of the core (create it in MinIO)

# --- Databases (one Postgres, one database per module; the compose stack creates them) --------
POSTGRES_PASSWORD=         # superuser password of the local Postgres

# --- Anthropic (scenario research/script, capture planner) ------------------------------------
ANTHROPIC_API_KEY=
MSCENARIO_MODEL=           # optional, e.g. claude-sonnet-5-5
MVGEN_MODEL=               # optional

# --- Telegram review --------------------------------------------------------------------------
MTGR_BOT_TOKEN=            # from @BotFather
MTGR_OWNERS=               # comma-separated Telegram user ids allowed to approve (first one gets the cards)
MTGR_MAX_ROUNDS=3
MTGR_DEADLINE_H=48

# --- Instagram publisher ----------------------------------------------------------------------
MIPUB_TOKEN_MAIN=          # system-user token (EAA...) for the account with code `main`
MIPUB_API_VERSION=v27.0
MIPUB_GRAPH_BASE=https://graph.facebook.com
# the Instagram business account id goes into the `accounts` table (see module README), not here

# --- Sandbox for capture (video generation) ---------------------------------------------------
MVGEN_SANDBOX_CATALOG=/etc/mvgen/sandbox-catalog.json   # copy modules/module-video-generation/sandbox-catalog.example.json

# --- Idea scheduler ---------------------------------------------------------------------------
MIDEA_PIPELINE=video
MIDEA_MAX_IN_FLIGHT=1
MIDEA_MIN_INTERVAL_S=3600
