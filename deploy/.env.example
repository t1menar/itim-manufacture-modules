# Скопируйте в deploy/.env (генерируется up.sh автоматически). НЕ коммитьте.
COMPOSE_PROJECT_NAME=manufacture

POSTGRES_USER=manufacture
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=56432

RABBITMQ_PORT=56672
RABBITMQ_MGMT_PORT=56673

MINIO_ROOT_USER=manufacture
MINIO_ROOT_PASSWORD=change_me
MINIO_API_PORT=56000
MINIO_CONSOLE_PORT=56001
S3_BUCKET=manufacture
# Для live Instagram: host туннеля cloudflared/ngrok на :56000
S3_PUBLIC_ENDPOINT=127.0.0.1:56000
S3_PUBLIC_SECURE=0

CORE_PORT=58080
# Формат: <version>:<base64 of exactly 32 bytes>
CORE_MASTER_KEY=
# Admin bearer (prefix mfa_)
CORE_ADMIN_TOKEN=

VIDEO_PORT=58081
REVIEW_PORT=58082
PUBLISH_PORT=58083
ADMIN_API_PORT=58084

# Выдаются core при регистрации (up.sh дописывает)
MODULE_TOKEN_VIDEO=mft_pending_video
MODULE_TOKEN_REVIEW=mft_pending_review
MODULE_TOKEN_PUBLISH=mft_pending_publish

REVIEW_TELEGRAM_MODE=real
PUBLISH_INSTAGRAM_MODE=real
# graph.instagram.com for an Instagram-Login token (IGAA...), graph.facebook.com for a Business Manager system user token (EAA...)
PUBLISH_INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
# Meta accepts only ~2 MiB per direct upload: use "url" with an SFTP-reachable public host for real reels.
PUBLISH_INSTAGRAM_UPLOAD_MODE=direct
#PUBLISH_VIDEO_HOST=reels@your.host
#PUBLISH_VIDEO_HOST_DIR=/var/www/reels
#PUBLISH_VIDEO_HOST_URL=https://your.host/reels
#PUBLISH_VIDEO_HOST_KEY_B64=   # base64 of the private key (never commit)
VIDEO_IDEAS_PAUSED=0
# seconds between two started ideas (7200 = one video every 2 hours, 0 = no spacing)
VIDEO_IDEAS_INTERVAL_S=7200
MVIDEO_PIPELINE=real
DOCKER_GID=0
VIDEO_AGENT_NETWORK=manufacture_agents
