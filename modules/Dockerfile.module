# One image recipe for every iTim module. Build from the repository root:
#   docker build -f modules/Dockerfile.module --build-arg MODULE=module-scenario --build-arg PKG=mscenario -t itim-scenario .
FROM python:3.12-slim
ARG MODULE
ARG PKG
ARG SDK_REF=04daa2578581d10870d8fec25e215972c9b498cb
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir "manufacture-sdk @ git+https://github.com/t1menar/manufacture-sdk-python.git@${SDK_REF}"
COPY packages/mf-storage /src/packages/mf-storage
COPY packages/mvrender /src/packages/mvrender
RUN pip install --no-cache-dir /src/packages/mf-storage "/src/packages/mvrender[render]"
COPY modules/${MODULE} /app
RUN pip install --no-cache-dir . && python -c "import ${PKG}"
ENV MODULE_PKG=${PKG} MF_HEALTH_ADDR=:8081
CMD ["sh", "-c", "alembic upgrade head && exec mf-module run ${MODULE_PKG}.adapter:app"]
