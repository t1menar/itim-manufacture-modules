# Everything has a default for a local run; set only what differs.
MODULE_CORE_URL=http://host.docker.internal:8000
MODULE_CORE_TOKEN=dev-token
POSTGRES_PASSWORD=video
MINIO_ROOT_USER=manufacture
MINIO_ROOT_PASSWORD=manufacture_dev_secret
S3_BUCKET=manufacture
# Group id of /var/run/docker.sock (Linux: stat -c %g /var/run/docker.sock). 0 on Docker Desktop.
DOCKER_GID=0
# real = Claude agents, sandbox and render. Empty or "fake" = fake steps (smoke test of the plumbing).
MVIDEO_PIPELINE=real
