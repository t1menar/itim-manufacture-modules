{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-review-output.json",
  "title": "core-04 §8.2 with C35 (non-whitespace reason) and optional C37",
  "type": "object",
  "required": [
    "decision",
    "reviewer",
    "decided_at",
    "round"
  ],
  "properties": {
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "reviewer": {
      "type": "object",
      "required": [
        "telegram_user_id"
      ],
      "properties": {
        "telegram_user_id": {
          "type": "integer"
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "content_revision_id": {
      "type": "string",
      "format": "uuid",
      "description": "proposed C37"
    }
  },
  "if": {
    "properties": {
      "decision": {
        "const": "rejected"
      }
    }
  },
  "then": {
    "required": [
      "reason"
    ],
    "properties": {
      "reason": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
