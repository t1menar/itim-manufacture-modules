{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.json",
  "type": "object",
  "required": [
    "output",
    "artifacts"
  ],
  "properties": {
    "output": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "sha256",
          "size",
          "kind"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^s3://manufacture/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "video",
              "image",
              "json",
              "text"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
