{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info.json",
  "title": "Module /info (core-04 §7.1)",
  "type": "object",
  "required": [
    "name",
    "version",
    "contract",
    "stages",
    "settings_schema"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+].*)?$"
    },
    "contract": {
      "type": "integer",
      "minimum": 1
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "settings_schema": {
      "type": "object"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "admin_endpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/admin/v1/"
      }
    }
  }
}
