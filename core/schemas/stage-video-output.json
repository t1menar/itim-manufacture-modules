{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-video-output.json",
  "type": "object",
  "required": [
    "variants",
    "provenance"
  ],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "language",
          "video",
          "post"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "video": {
            "type": "object",
            "required": [
              "ref",
              "sha256",
              "duration_s",
              "size",
              "width",
              "height",
              "fps"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^s3://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "fps": {
                "type": "number"
              }
            }
          },
          "contact_sheet": {
            "$ref": "#/$defs/artifact"
          },
          "cover": {
            "$ref": "#/$defs/artifact"
          },
          "preview": {
            "type": "object",
            "required": [
              "ref",
              "size"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^s3://"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 47185920
              }
            }
          },
          "script_ref": {
            "type": "string",
            "pattern": "^s3://"
          },
          "post": {
            "type": "object",
            "required": [
              "caption"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "hashtags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          },
          "checks": {
            "type": "object"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "changes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "proposed C39; platform limits are validated by adapters, not here",
      "required": [
        "title",
        "description",
        "topics",
        "platforms"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "caption",
              "hashtags"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "hashtags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#\\S+$"
                }
              },
              "fields": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
