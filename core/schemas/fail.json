{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fail.json",
  "type": "object",
  "required": [
    "class",
    "message"
  ],
  "properties": {
    "class": {
      "enum": [
        "transient",
        "fatal",
        "blocked"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "details": {
      "type": "object",
      "properties": {
        "retry_after": {
          "type": "string",
          "format": "date-time"
        },
        "code": {
          "type": "string"
        }
      }
    }
  }
}
