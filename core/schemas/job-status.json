{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-status.json",
  "type": "object",
  "required": [
    "job_id",
    "status"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress": {
      "$ref": "progress.json"
    },
    "result": {
      "$ref": "result.json"
    },
    "fail": {
      "$ref": "fail.json"
    }
  }
}
