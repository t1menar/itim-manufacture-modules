{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress.json",
  "type": "object",
  "required": [
    "percent",
    "step"
  ],
  "properties": {
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "maxLength": 500
    }
  }
}
