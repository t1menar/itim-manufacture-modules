{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-request.json",
  "title": "Job request, contract 1 (core-04 §7.2); fence added by proposed C31",
  "type": "object",
  "required": [
    "job_id",
    "attempt",
    "production_id",
    "stage",
    "mode",
    "variant",
    "input",
    "settings",
    "credentials",
    "callback",
    "deadline"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "try": {
      "type": "integer",
      "minimum": 1
    },
    "fence": {
      "type": "integer",
      "minimum": 1,
      "description": "proposed C31"
    },
    "production_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "mode": {
      "enum": [
        "create",
        "revise"
      ]
    },
    "variant": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "language"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "idea",
        "channels",
        "upstream"
      ],
      "properties": {
        "idea": {
          "type": "object",
          "required": [
            "id",
            "text",
            "language"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "language": {
              "type": "string"
            }
          }
        },
        "variants": {
          "type": "array"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "language",
              "name",
              "settings"
            ]
          }
        },
        "previous": {
          "type": "object",
          "required": [
            "script_ref",
            "review_reason",
            "round"
          ]
        },
        "upstream": {
          "type": "object"
        },
        "review_round": {
          "type": "integer",
          "minimum": 1
        },
        "content_revision_id": {
          "type": "string",
          "format": "uuid",
          "description": "proposed C37"
        },
        "publish_intents": {
          "type": "array",
          "description": "proposed C38",
          "items": {
            "type": "object",
            "required": [
              "intent_id",
              "platform_account_id",
              "generation",
              "content_revision_id"
            ],
            "properties": {
              "intent_id": {
                "type": "string",
                "format": "uuid"
              },
              "platform_account_id": {
                "type": "string",
                "format": "uuid"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "content_revision_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "version",
        "values"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "type": "object"
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cred:[a-z0-9][a-z0-9-]{1,59}$"
      }
    },
    "callback": {
      "type": "object",
      "required": [
        "base_url"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "revise"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "type": "object"
          },
          "input": {
            "required": [
              "previous"
            ]
          }
        }
      }
    }
  ]
}
