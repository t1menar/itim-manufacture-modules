{
  "$id": "admin/republish-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason", "base_generation"],
  "properties": {
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "base_generation": { "type": "integer", "minimum": 1 },
    "acknowledge_unknown_risk": { "type": "boolean" },
    "content_revision_id": { "type": "string", "format": "uuid" }
  }
}
