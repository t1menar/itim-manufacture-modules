{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-metadata-output.json",
  "title": "Proposed stage metadata (C39, P1); not seeded until accepted",
  "type": "object",
  "required": [
    "metadata",
    "provenance"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "proposed C39; platform limits are validated by adapters, not here",
      "required": [
        "title",
        "description",
        "topics",
        "platforms"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "caption",
              "hashtags"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "hashtags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#\\S+$"
                }
              },
              "fields": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "prompts"
      ],
      "properties": {
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "prompt_id",
              "version",
              "sha256"
            ],
            "properties": {
              "prompt_id": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "model": {
          "type": "string"
        }
      }
    }
  }
}
