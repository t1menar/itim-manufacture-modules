{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manufacture/schemas/review-telegram/input/1",
  "title": "review job input (fields this module reads)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "idea_ref",
    "channels",
    "upstream"
  ],
  "properties": {
    "idea_ref": {
      "type": "object",
      "required": ["id", "rev"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "rev": {"type": "integer", "minimum": 1}
      },
      "description": "D21: opaque idea reference; idea body lives in module-video"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "language": {"type": "string"}
        }
      }
    },
    "upstream": {
      "type": "object",
      "properties": {
        "content_revision": {"type": "object"},
        "video": {"type": "object"},
        "video_ref": {"type": "string"}
      }
    },
    "review_round": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "type": "object"
    }
  }
}
